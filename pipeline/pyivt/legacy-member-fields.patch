+/// The raw values of an integer-reference field, for fields whose values do not
+/// point at note records: legacy tables carry sort orders (`_Sort`) with this
+/// type code, holding member ordinals. Zero stays null, as for note references.
+fn reference_ordinals(record: &[u8]) -> Result<MemberValues, String> {
+    if record[0] & 15 != 4 || record[1] != 1 {
+        return Err("member text references are not an integer vector".into());
+    }
+    Ok(MemberValues::Int64(
+        record[4..]
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .map(|scalar| match u32(scalar, 0) {
+                0 => None,
+                v => Some(i64::from(v)),
+            })
+            .collect(),
+    ))
+}
+
+/// Whether every reference in the chunk resolves to a note record, so that
+/// [`referenced_strings`] can read it. A reference outside the directory or to a
+/// record of another shape means the field holds ordinals, not note references.
+fn references_resolve(dir: &Directory<'_>, record: &[u8]) -> bool {
+    record[0] & 15 == 4
+        && record[1] == 1
+        && record[4..].as_chunks::<4>().0.iter().all(|scalar| {
+            let index = u32(scalar, 0) as usize;
+            index == 0
+                || match dir.record(index) {
+                    Ok(None) => true,
+                    Ok(Some(text)) => text.len() >= 5 && text[0] & 15 == 1 && text[1] == 1,
+                    Err(_) => false,
+                }
+        })
+}
