 pub type MemberField = (String, Vec<Option<String>>);
 
+/// Chunks of one reference field must share a storage type. Chunks of zero
+/// references read as all-null text and as all-null ordinals alike, so an
+/// all-null accumulator adopts the type of the chunk that decides it; a chunk
+/// of all nulls adopts the accumulator's.
+fn reconcile_reference_chunks(values: &mut MemberValues, chunk: &MemberValues) {
+    let all_null = |v: &MemberValues| match v {
+        MemberValues::Utf8(v) => v.iter().all(Option::is_none),
+        MemberValues::Int64(v) => v.iter().all(Option::is_none),
+        _ => false,
+    };
+    match (&*values, chunk) {
+        (MemberValues::Utf8(v), MemberValues::Int64(_)) if all_null(values) => {
+            *values = MemberValues::Int64(vec![None; v.len()]);
+        }
+        (MemberValues::Int64(v), MemberValues::Utf8(_)) if all_null(values) => {
+            *values = MemberValues::Utf8(vec![None; v.len()]);
+        }
+        _ => {}
+    }
+}
+
+/// The counterpart for the incoming chunk, applied by the caller before append.
+impl MemberValues {
+    fn adopt_type_of(self, other: &MemberValues) -> MemberValues {
+        let n = self.len();
+        let all_null = match &self {
+            MemberValues::Utf8(v) => v.iter().all(Option::is_none),
+            MemberValues::Int64(v) => v.iter().all(Option::is_none),
+            _ => false,
+        };
+        match (all_null, &self, other) {
+            (true, MemberValues::Utf8(_), MemberValues::Int64(_)) => MemberValues::Int64(vec![None; n]),
+            (true, MemberValues::Int64(_), MemberValues::Utf8(_)) => MemberValues::Utf8(vec![None; n]),
+            _ => self,
+        }
+    }
+}
