+    #[test]
+    fn reference_fields_without_note_targets_are_ordinals() {
+        let mut record = vec![4, 1, 3, 0];
+        for v in [1u32, 0, 59_408] {
+            record.extend_from_slice(&v.to_le_bytes());
+        }
+        let MemberValues::Int64(values) = reference_ordinals(&record).unwrap() else {
+            panic!()
+        };
+        assert_eq!(values, [Some(1), None, Some(59_408)]);
+        assert!(reference_ordinals(&[1, 1, 0, 0]).is_err());
+    }
+
+    #[test]
+    fn reference_chunks_of_nulls_adopt_the_deciding_type() {
+        let mut acc = MemberValues::Utf8(vec![None, None]);
+        let chunk = MemberValues::Int64(vec![Some(3)]);
+        reconcile_reference_chunks(&mut acc, &chunk);
+        acc.append(chunk.adopt_type_of(&acc)).unwrap();
+        assert!(matches!(&acc, MemberValues::Int64(v) if v == &[None, None, Some(3)]));
+        let mut acc = MemberValues::Utf8(vec![Some("a".into())]);
+        let chunk = MemberValues::Int64(vec![None]);
+        reconcile_reference_chunks(&mut acc, &chunk);
+        acc.append(chunk.adopt_type_of(&acc)).unwrap();
+        assert!(matches!(&acc, MemberValues::Utf8(v) if v == &[Some("a".into()), None]));
+    }
