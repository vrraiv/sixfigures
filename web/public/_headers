# Every response. The site is its own files and nothing else: no script, style, font, image or
# request from anywhere but here (the pages' own inline scripts and styles are allowed; they
# are written at build time). vite.config.js sends the same policy from `vite preview`.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/tiles/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800

/search.json
  Cache-Control: public, max-age=31536000, immutable

/breaks.json
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/about/
  Cache-Control: no-cache

/about/index.html
  Cache-Control: no-cache

/brand-map.svg
  Cache-Control: public, max-age=31536000, immutable

/census/
  Cache-Control: no-cache
  Document-Policy: js-profiling

/census/index.html
  Cache-Control: no-cache
  Document-Policy: js-profiling

/2011/
  Cache-Control: no-cache
  Document-Policy: js-profiling

/2011/index.html
  Cache-Control: no-cache
  Document-Policy: js-profiling

/insights/
  Cache-Control: no-cache

/insights/index.html
  Cache-Control: no-cache

/insights/schools/
  Cache-Control: no-cache

/insights/schools/index.html
  Cache-Control: no-cache

/insights.json
  Cache-Control: public, max-age=3600

/insights/housing/
  Cache-Control: no-cache

/insights/housing/index.html
  Cache-Control: no-cache

/housing.json
  Cache-Control: public, max-age=3600

/schools.json
  Cache-Control: public, max-age=3600

/data/figures/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600
