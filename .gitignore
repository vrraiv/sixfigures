# --- large / raw data (rebuilt by `make download` / `make data`) ---
pipeline/raw/
pipeline/out/
*.zip
*.7z
*.tar.gz
*.part
*.crdownload
# shapefile components and other GIS bulk formats
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.gdb/
*.gpkg
*.gml
*.mbtiles
*.parquet
